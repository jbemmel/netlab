{# Export only runtime topology fields; never include inventory credentials. #}
{% set ns = namespace(nodes={}, links={}, modules=[]) %}
{% for n_name,n in hostvars.items() %}
{%   set item = {} %}
{%   for m in n.module|default([]) if m not in ns.modules %}
{%     set _ = ns.modules.append(m) %}
{%   endfor %}
{%   for intf in n.interfaces|default([]) if intf.linkindex is defined %}
{%     set idx = intf.linkindex|string %}
{%     if idx not in ns.links %}
{%       set _ = ns.links.update({idx: {'interfaces': []}}) %}
{%     endif %}
{%     set endpoint = {'node': n_name} %}
{%     set _ = endpoint.update(intf) %}
{%     set _ = ns.links[idx].interfaces.append(endpoint) %}
{%   endfor %}
{%   for key in ['id', 'name', 'device', 'role', 'mgmt', 'loopback', 'interfaces', 'bgp', 'ospf', 'isis'] if key in n %}
{%     set _ = item.update({key: n[key]}) %}
{%   endfor %}
{%   if n.device == 'labnet' %}
{%     set _ = item.update({'device': 'lab.net', 'ws': {'port': n.labnet.port|default(8080), 'https': n.labnet.https|default(false)}}) %}
{%   endif %}
{%   set _ = ns.nodes.update({n_name: item}) %}
{% endfor %}
{{ {'name': inventory_hostname, 'listenHost': '0.0.0.0', 'token': labnet.token|default('lab-net-browser-connect'), 'topology': {'nodes': ns.nodes, 'links': ns.links.values()|list, 'module': ns.modules}} | tojson(indent=2) }}
