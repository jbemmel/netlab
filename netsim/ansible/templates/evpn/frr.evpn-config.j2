{% set evpn_transport = evpn.transport|default('vxlan') %}
{% set evpn_vrfs = evpn.vrfs|default([]) %}
router bgp {{ bgp.as }}
 address-family l2vpn evpn
{% if evpn_transport in ['vxlan','ip'] %}
  advertise-all-vni
{% endif %}
{% if evpn_transport == 'vxlan' %}
  advertise-svi-ip
{% endif %}
{% if evpn_transport != 'ip' or not evpn_vrfs %}
{% for af in ['ipv4','ipv6'] if af in bgp %}
  advertise {{ af }} unicast
{% endfor %}
{% endif %}
{% if evpn_transport == 'ip' and not evpn_vrfs %}
  rd {{ bgp.router_id }}:1
  route-target export {{ bgp.as }}:1
  route-target import {{ bgp.as }}:1
{% endif %}

{% if evpn_transport == 'vxlan' %}
! Configure explicit Route Targets and RD per L2 VNI; auto-derived differs
{% for vlan in (vlans|default({})).values() if 'vni' in vlan and 'evpn' in vlan %}
  vni {{ vlan.vni }}
   rd {{ vlan.evpn.rd }}
{%   for dir in ['import','export'] if vlan.evpn[dir]|default([]) %}
{%     for cmnt in vlan.evpn[dir] %}
   route-target {{ dir }} {{ cmnt }}
{%     endfor %}
{%   endfor %}
  exit-vni
{% endfor %}
{% endif %}

{% for n in bgp.neighbors if n.evpn|default(False) %}
{%   set peer = n.local_if|default(n[n.evpn]) %}
  neighbor {{ peer }} activate
{%   if n.rr_client|default(False) %}
  neighbor {{ peer }} route-reflector-client
{%   endif %}
{%   if n.next_hop_self|default(False) %}
  neighbor {{ peer }} next-hop-self{% if n.next_hop_self == 'all' %} force{% endif +%}
{%   endif %}
{% endfor %}

 exit-address-family
!
 
exit

! L3 VRF EVPN handling
{% if vrfs is defined %}
{% for vname,vdata in vrfs.items() if 'evpn' in vdata %}
vrf {{ vname }}
{% if vdata.evpn.transit_vni is defined %}
 vni {{ vdata.evpn.transit_vni }}
{% endif %}
 exit-vrf

router bgp {{ bgp.as }} vrf {{ vname }}
 address-family l2vpn evpn
{% if vdata.evpn.transit_vni is defined %}
  ! This sets the EVPN RD/RT for this VRF
  rd {{ vdata.rd }}
  route-target export {{ vdata.export[0] }}
  route-target import {{ vdata.import[0] }}
{% endif %}
  ! Enable RT5 advertisements
{% for af in ['ipv4','ipv6'] if af in vdata.af|default([]) and vdata.af[af] %}
  advertise {{ af }} unicast
{% endfor %}
 exit-address-family
exit
!
{% endfor %}
{% endif %}
!
do write
