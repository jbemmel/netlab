module netlab-topology-post-transform {
  yang-version 1.1;
  namespace "urn:netlab:topology:post-transform";
  prefix "netlab-post";

  import netlab-topology-init {
    prefix netlab-init;
    revision-date 2025-12-12;
  }
  import netlab-topology-setup {
    prefix setup;
    revision-date 2025-12-12;
  }

  description
    "YANG model for netlab lab topology validation at Post-transform phase.
     This model validates the topology after all transformations are complete, when:
     - All node and link transformations are done
     - Interfaces have been created on nodes and links
     - All internal attributes have been added (sources, pools, Plugin, Provider, input)
     - Topology is in its final state ready for deployment
     
     At this phase:
     - Nodes are lists with IDs, management IPs, loopback addresses, and interfaces
     - Links are lists with linkindex, interfaces, and node_count
     - Interfaces have ifindex, ifname, ipv4, ipv6, linkindex, type attributes
     - defaults.sources is present
     - Internal structures (pools, Plugin, Provider, input) are present";

  revision 2025-12-12 {
    description "Initial version for post-transform phase validation";
  }

  container topology {
    description
      "Network lab topology structure at post-transform phase (final transformed state).";
    
    // Use base topology grouping for common elements
    uses netlab-init:topology-base-grouping;

    list nodes {
      key "name";
      description
        "Lab devices (nodes) after all transformations. Nodes have IDs, management IPs,
         loopback addresses, and interfaces.";
      
      leaf name {
        type string;
        mandatory true;
      }
      
      leaf id {
        type uint32 {
          range "1..150";
        }
        mandatory true;
      }
      
      leaf device {
        type string;
        description "Device type for this node";
      }
      
      leaf provider {
        type string;
        description "Virtualization provider for this node";
      }
      
      leaf box {
        type string;
        description "Vagrant box or Docker container identifier";
      }
      
      leaf mtu {
        type uint32 {
          range "64..9216";
        }
        description "Device-wide (system) MTU";
      }
      
      leaf role {
        type enumeration {
          enum router;
          enum host;
          enum bridge;
          enum gateway;
        }
        description "Node role";
      }
      
      leaf-list module {
        type string;
        description "List of configuration modules";
      }
      
      leaf-list group {
        type string;
        description
          "List of group names this node belongs to. Groups can be used to
           set node attributes, set Ansible group variables, or limit the
           scope of netlab commands.";
      }
      
      anydata mgmt {
        description "Management interface configuration";
      }
      
      anydata loopback {
        description "Loopback interface configuration";
      }
      
      anydata ospf {
        description "OSPF module-specific node attributes";
      }
      
      anydata bgp {
        description "BGP module-specific node attributes";
      }
      
      anydata isis {
        description "ISIS module-specific node attributes";
      }
      
      anydata vlan {
        description "VLAN module-specific node attributes";
      }
      
      anydata vrf {
        description "VRF module-specific node attributes";
      }
      
      anydata af {
        description "Address family configuration";
      }
      
      anydata routing {
        description "Routing module node attributes";
      }
      
      anydata node_attrs {
        description "Other node attributes (flexible structure)";
      }
      
      // Nodes should have interfaces after link transformation
      list interfaces {
        key "ifindex";
        description
          "Node interfaces created during link transformation.";
        
        leaf ifindex {
          type uint32 {
            range "0..max";
          }
          description "Interface index";
        }
        
        leaf ifname {
          type string;
          description "Interface name";
        }
        
        leaf ipv4 {
          type union {
            type boolean;
            type string;
          }
          description "IPv4 address";
        }
        
        leaf ipv6 {
          type union {
            type boolean;
            type string;
          }
          description "IPv6 address";
        }
        
        leaf linkindex {
          type uint32 {
            range "1..max";
          }
          description "Link index this interface belongs to";
        }
        
        leaf type {
          type string;
          description "Interface type";
        }
        
        leaf name {
          type string;
          description "Interface name/description";
        }
        
        leaf mtu {
          type uint32 {
            range "64..9216";
          }
          description "Interface MTU";
        }
        
        anydata neighbors {
          description "List of neighbor interfaces";
        }
        
        // Module-specific interface attributes (added during post_transform)
        container ospf {
          description "OSPF module-specific interface attributes (added during post_transform)";
          leaf area {
            type string;
            description "OSPF area";
          }
          leaf network_type {
            type string;
            description "OSPF network type";
          }
          leaf passive {
            type boolean;
            description "Passive interface flag";
          }
          anydata ospf_attrs {
            description "Other OSPF interface attributes";
          }
        }
        
        anydata routing {
          description "Routing module-specific interface attributes";
        }
        
        anydata bgp {
          description "BGP module-specific interface attributes";
        }
        
        anydata interface_data {
          description "Other interface attributes";
        }
      }
      
      anydata node_attrs {
        description "Other node attributes";
      }
    }

    // Links now have interfaces
    list links {
      key "linkindex";
      description
        "Links between lab devices after all transformations. Links have interfaces.";
      
      leaf linkindex {
        type uint32 {
          range "1..max";
        }
      }
      
      leaf node_count {
        type uint32 {
          range "1..max";
        }
        description "Number of nodes connected to this link";
      }
      
      list interfaces {
        key "node";
        description
          "Interfaces connected by this link. Each interface represents a node attachment.";
        
        leaf node {
          type leafref {
            path "../../../nodes/name";
            require-instance true;
          }
          mandatory true;
          description "Node name";
        }
        
        leaf ipv4 {
          type union {
            type boolean;
            type string;
          }
          description "IPv4 address";
        }
        
        leaf ipv6 {
          type union {
            type boolean;
            type string;
          }
          description "IPv6 address";
        }
        
        leaf ifindex {
          type uint32 {
            range "0..max";
          }
          description "Interface index";
        }
        
        leaf ifname {
          type string;
          description "Interface name";
        }
        
        anydata interface_attrs {
          description "Additional interface attributes";
        }
      }
      
      leaf type {
        type enumeration {
          enum p2p {
            description "Point-to-point link between two nodes";
          }
          enum lan {
            description "Multi-access link (LAN)";
          }
          enum stub {
            description "Stub link (single node attachment)";
          }
          enum loopback {
            description "Loopback link";
          }
          enum tunnel {
            description "Tunnel link";
          }
          enum vlan_member {
            description "VLAN member link";
          }
          enum lag {
            description "Link aggregation group (LAG)";
          }
        }
        description
          "Link type. Valid values: p2p (point-to-point), lan (multi-access),
           stub (single node attachment), loopback, tunnel, vlan_member, lag.
           When missing, link type is selected based on the number of devices
           connected to the link.";
      }
      
      leaf bandwidth {
        type uint32 {
          range "1..max";
        }
        description
          "Link bandwidth in Mbps. Used to configure interface bandwidth
           when supported by the connected device(s). Must be at least 1 Mbps.";
      }
      
      leaf bridge {
        type string;
        description
          "Bridge name for this link. Used in libvirt provider to specify
           the Linux bridge name for the link.";
      }
      
      leaf pool {
        type string;
        description
          "Address pool name to use for this link. References a pool defined
           in the addressing element.";
      }
      
      anydata prefix {
        description
          "Prefix for this link. Can be a string (IPv4 CIDR or prefix name), 
           a dictionary with ipv4/ipv6/allocation keys, or false (for layer-2-only links).";
      }
      
      leaf name {
        type string;
        description
          "Link name. Used for identification and in some provider configurations.";
      }
      
      leaf mtu {
        type uint32 {
          range "64..9216";
        }
        description
          "Link MTU. Valid range: 64-9216 bytes.";
      }
      
      container ra {
        description
          "IPv6 Router Advertisement (RA) configuration for this link.";
        leaf disable {
          type boolean;
          description
            "Disable Router Advertisements on this link.";
        }
        leaf slaac {
          type boolean;
          description
            "Enable Stateless Address Autoconfiguration (SLAAC).";
        }
        leaf dhcp {
          type string;
          description
            "DHCP configuration: 'all' or 'other'.";
        }
        leaf onlink {
          type boolean;
          description
            "Advertise on-link prefix.";
        }
        anydata ra_config {
          description
            "Additional RA configuration attributes (flexible structure)";
        }
      }
      
      anydata link_attrs {
        description "Other link attributes";
      }
    }

    // Internal data structures (added during transformation)
    anydata Provider {
      description "Provider internal data";
    }
    anydata pools {
      description "Address pools (internal representation)";
    }

    must "count(nodes) > 0" {
      error-message "Topology must contain at least one node";
    }
  }
}

